# Apache / LiteSpeed Configuration for cPanel Node.js (Phusion Passenger)
DirectoryIndex app.js index.html

# Prevent gzip/mod_deflate corrupting JSON API responses
<IfModule mod_deflate.c>
  SetEnvIfNoCase Request_URI "^/api/" no-gzip dont-vary
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(json|js|css)$">
    Header set Cache-Control "no-cache, no-transform"
  </FilesMatch>
</IfModule>

# Handle SPA fallback routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteRule ^ index.html [L]
</IfModule>
